// Modal para guardar chat
Future<void> showSaveChatModal(BuildContext context, List<ChatMessage> messages, Function(SavedChat) onSave) async {
  final TextEditingController titleController = TextEditingController();
  await showDialog(
    context: context,
    builder: (context) {
      return AlertDialog(
        title: const Text('Guardar Chat'),
        content: TextField(
          controller: titleController,
          decoration: const InputDecoration(
            hintText: 'Título para este chat',
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Cancelar'),
          ),
          ElevatedButton(
            onPressed: () {
              final title = titleController.text.trim().isEmpty ? 'Chat guardado ${DateTime.now().hour}:${DateTime.now().minute}' : titleController.text.trim();
              final newChat = SavedChat(title: title, id: DateTime.now().microsecondsSinceEpoch.toString(), messages: List.from(messages));
              onSave(newChat);
              Navigator.of(context).pop();
            },
            child: const Text('Guardar'),
          ),
        ],
      );
    },
  );
}


