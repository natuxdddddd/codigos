  final ScrollController _scrollController = ScrollController(); // Controlador de scroll
  bool _isLoading = false;
  List<ChatMessage> _messages = [];
  List<SavedChat> _savedChats = [];
  bool _isChatModified = false;

  @override
  void initState() {
    super.initState();
    _loadSavedChats();
    WidgetsBinding.instance.addObserver(this); // Registrar observer
  }

  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this); // Desregistrar observer
    _scrollController.dispose();
    super.dispose();
  }
  
  // Nuevo: Maneja el ciclo de vida de la aplicación para guardar chats
  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    super.didChangeAppLifecycleState(state);
    // Cuando la app va al background o está a punto de cerrarse
    if (state == AppLifecycleState.paused) {
      _checkAndPromptSaveOnClose();
    }
  }

  void _checkAndPromptSaveOnClose() {
    if (_isChatModified && _messages.isNotEmpty) {
      // Usamos Future.delayed para asegurar que el modal se muestre
      Future.delayed(Duration.zero, () {
        showSaveChatModal(context, _messages, _saveChat);
      });
    }
  }
  
  // Función para desplazar el chat al final
  void _scrollToBottom() {
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (_scrollController.hasClients) {
        _scrollController.animateTo(
          _scrollController.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      }
    });
  }

  // --- PERSISTENCIA DE CHATS ---

  Future<void> _loadSavedChats() async {
    final prefs = await SharedPreferences.getInstance();
    final chatStrings = prefs.getStringList('saved_chats') ?? [];
    setState(() {
      _savedChats = chatStrings
          .map((s) => SavedChat.fromJson(json.decode(s) as Map<String, dynamic>))
          .toList();
    });
  }

  Future<void> _saveChat(SavedChat newChat) async {
    final prefs = await SharedPreferences.getInstance();
    _savedChats.add(newChat);
    final chatStrings = _savedChats.map((c) => json.encode(c.toJson())).toList();
    await prefs.setStringList('saved_chats', chatStrings);
    setState(() {
      _isChatModified = false;
    });
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Chat "${newChat.title}" guardado.')),
    );
  }
  
  void _deleteChat(String id) async {
    final prefs = await SharedPreferences.getInstance();
    setState(() {
      _savedChats.removeWhere((chat) => chat.id == id);
    });
    final chatStrings = _savedChats.map((c) => json.encode(c.toJson())).toList();
    await prefs.setStringList('saved_chats', chatStrings);
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Chat eliminado.')),
    );
  }

  void _loadChat(List<ChatMessage> messages) {
    setState(() {
      _messages = messages;
      _isChatModified = false;
    });
    Navigator.of(context).pop(); // Cierra el Drawer
    _scrollToBottom();
  }

  void _startNewChat() {
    if (_isChatModified) {
        _showUnsavedChatWarning();
        return;
    }
    setState(() {
      _messages = [];
      _isChatModified = false;
    });
    Navigator.of(context).pop(); // Cierra el Drawer
  }
  
  void _showUnsavedChatWarning() {
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: const Text('Guardar Chat Actual'),
          content: const Text('Tienes una conversación sin guardar. ¿Deseas guardarla antes de empezar una nueva?'),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.of(context).pop();
                _startNewChatForce();
              },
              child: const Text('Descartar y Nuevo'),
            ),
            ElevatedButton(
              onPressed: () {
                Navigator.of(context).pop();
                showSaveChatModal(context, _messages, _saveChat);
                _startNewChatForce();
              },
              child: const Text('Guardar y Nuevo'),
            ),
          ],
        );
      },
    );
  }
  
  void _startNewChatForce() {
    setState(() {
      _messages = [];
      _isChatModified = false;
    });
    Navigator.of(context).pop(); // Cierra el Drawer si está abierto
  }


  // --- LÓGICA DEL CHATBOT ---

  Future<void> sendMessage(String message) async {
    if (message.trim().isEmpty) return;

    // 1. Detección de Crisis (Suicidio)
    final lowerCaseMessage = message.toLowerCase();
    if (lowerCaseMessage.contains('suicid') ||
        lowerCaseMessage.contains('morir') ||
        lowerCaseMessage.contains('matarme') ||
        lowerCaseMessage.contains('ya no quiero vivir')) {
      await showEmergencyModal(context);
      _controller.clear();
      return;
    }
    
    // 2. Detección de "Gracias" (Guardado de Chat)
    if (lowerCaseMessage.trim() == 'gracias') {
      _controller.clear();
      if (_isChatModified && _messages.isNotEmpty) {
        await showSaveChatModal(context, _messages, _saveChat);
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No hay chat nuevo para guardar.')),
        );
      }
      return;
    }

    setState(() {
      _messages.add(ChatMessage(text: message, isUser: true));
      _isChatModified = true;
      _isLoading = true;
    });
    _scrollToBottom();

    // Límite de Historial para Contexto (Optimización)
    // Conserva solo los últimos 10 mensajes (5 pares) para el contexto de la API.
    final historyLength = _messages.length > 10 ? _messages.length - 10 : 0;
    final contextMessages = _messages.sublist(historyLength);


    // V A L O R   I M P O R T A N T E:
    const apiKey =
        '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'; 
    const endpoint = 'https://openrouter.ai/api/v1/chat/completions';
    
    try {
      final response = await http.post(
        Uri.parse(endpoint),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $apiKey',
        },
        body: json.encode({
          'model': 'openai/gpt-4-turbo',
          'messages': [
            {
              'role': 'system', 
              'content':
                  'Eres un amigo terapeuta llamado PsicoAmIgo que brinda apoyo emocional y psicológico de manera empática y amable y en ningun momento te saldras de tu papel y ten en claro que no eres uno no buscas sustituir solo complementar.',
            },
            // Se envían solo los mensajes recientes para ahorrar costos y mejorar la velocidad.
            ...contextMessages.map(
              (m) => {
                'role': m.isUser ? 'user' : 'assistant',
                'content': m.text,
              },
            ),
          ],
        }),
      );
      if (response.statusCode == 200) {
        final body = json.decode(response.body);
        if (body['choices'] != null && body['choices'].isNotEmpty) {
          final reply = body['choices'][0]['message']['content'].trim();
          setState(() {
            _messages.add(ChatMessage(text: reply, isUser: false));
            _isLoading = false;
          });
          _scrollToBottom();
        } else {
          _handleApiError('Respuesta de IA vacía.');
        }
      } else {
        _handleApiError('Error de estado: ${response.statusCode}');
      }
    } catch (e) {
      _handleApiError('Error de red, intenta de nuevo.');
    }

    _controller.clear();
  }
  
  void _handleApiError(String message) {
      setState(() {
        _messages.add(
          ChatMessage(text: 'Lo siento, ocurrió un error: $message. Por favor, asegúrate de que tu clave API de OpenRouter es correcta.', isUser: false),
        );
        _isLoading = false;
      });
      _scrollToBottom();
  }

  // --- WIDGETS DE UI ---

  Widget _buildChatDrawer() {
    return Drawer(
      child: Column(
        children: [
          DrawerHeader(
            decoration: BoxDecoration(color: Theme.of(context).primaryColor),
            child: const Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Icon(Icons.history, color: Colors.white, size: 28),
                SizedBox(width: 10),
                Text(
                  'Chats Guardados',
                  style: TextStyle(color: Colors.white, fontSize: 24),
                ),
              ],
            ),
          ),
          ListTile(
            leading: const Icon(Icons.add_circle_outline),
            title: const Text('Iniciar Nuevo Chat'),
            onTap: _startNewChat,
          ),
          const Divider(),
          Expanded(
            child: _savedChats.isEmpty
                ? const Center(child: Text('No hay chats guardados.'))
                : ListView.builder(
                    itemCount: _savedChats.length,
                    itemBuilder: (context, index) {
                      final chat = _savedChats[index];
                      return ListTile(
                        leading: const Icon(Icons.chat_bubble_outline),
                        title: Text(chat.title, maxLines: 1, overflow: TextOverflow.ellipsis),
                        subtitle: Text('${chat.messages.length} mensajes'),
                        onTap: () => _loadChat(chat.messages),
                        trailing: IconButton(
                          icon: const Icon(Icons.delete, color: Colors.red),
                          onPressed: () => _deleteChat(chat.id),
                        ),
                      );
                    },
                  ),
          ),
          const Divider(),
          ListTile(
            leading: const Icon(Icons.email),
            title: const Text('Reportar Fallo / Sugerencia'),
            onTap: () {
              Navigator.of(context).pop(); // Cierra el drawer
              Navigator.of(context).push(
                MaterialPageRoute(builder: (_) => const ReportScreen()),
              );
            },
          ),
        ],
      ),
    );
  }

  Widget _buildChatContent() {
    if (_messages.isEmpty) {
      return Center(
        child: Padding(
          padding: const EdgeInsets.all(32.0),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(Icons.psychology_alt, size: 80, color: Theme.of(context).colorScheme.secondary),
              const SizedBox(height: 16),
              const Text(
                'Hola, soy PsicoAmIgo. ¿Cómo te sientes hoy?',
                textAlign: TextAlign.center, // Centrado de texto
                style: TextStyle(fontSize: 18, fontWeight: FontWeight.w500),
              ),
              const SizedBox(height: 8),
              const Text(
                'Escribe para iniciar una conversación.',
                textAlign: TextAlign.center, // Centrado de texto
              ),
            ],
          ),
        ),
      );
    }

    return ListView.builder(
      controller: _scrollController, // Asignar controlador de scroll
      padding: const EdgeInsets.all(16),
      itemCount: _messages.length,
      itemBuilder: (context, index) {
        final message = _messages[index];
        return Align(
          alignment: message.isUser
              ? Alignment.centerRight
              : Alignment.centerLeft,
          child: Container(
            margin: const EdgeInsets.symmetric(vertical: 4),
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: message.isUser
                  ? const Color(0xFF7178DF)
                  : const Color(0xFF9CA2EF),
              borderRadius: BorderRadius.circular(12),
            ),
            child: Text(
              message.text,
              style: const TextStyle(color: Colors.white),
            ),
          ),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('PsicoAmIgo - Chat IA'),
        actions: [
          // Botón de Líneas de Emergencia (Teléfono)
          IconButton(
            icon: const Icon(Icons.local_phone, color: Colors.redAccent),
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute(builder: (_) => const EmergencyLinesScreen()),
              );
            },
          ),
          // Selector de Tema (Switch)
          Row(
            children: [
              Icon(
                widget.isDarkMode ? Icons.dark_mode : Icons.light_mode,
                color: Colors.white,
              ),
              Switch(
                value: widget.isDarkMode,
                onChanged: widget.onThemeChanged,
                activeColor: Colors.white,
              ),
              const SizedBox(width: 12),
            ],
          ),
        ],
      ),
      drawer: _buildChatDrawer(), // Menú lateral para chats guardados
      body: Column(
        children: [
          Expanded(
            child: _buildChatContent(),
          ),
          if (_isLoading)
            const Padding(
              padding: EdgeInsets.all(8.0),
              child: CircularProgressIndicator(color: Color(0xFF3F448C)),
            ),
          Padding(
            padding: const EdgeInsets.all(8.0),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _controller,
                    decoration: const InputDecoration(
                      hintText: 'Escribe tu mensaje...',
                      focusedBorder: OutlineInputBorder(
                        borderSide: BorderSide(color: Color(0xFF5A61BD)),
                      ),
                      enabledBorder: OutlineInputBorder(
                        borderSide: BorderSide(color: Color(0xFF9CA2EF)),
                      ),
                    ),
                    onSubmitted: sendMessage,
                  ),
                ),
                const SizedBox(width: 8),
                ElevatedButton(
                  onPressed: () => sendMessage(_controller.text),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF5A61BD),
                    minimumSize: const Size(50, 48),
                  ),
                  child: const Icon(Icons.send),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
