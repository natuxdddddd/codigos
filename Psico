class HomeScreen extends StatefulWidget {
  final bool isDarkMode;
  final ValueChanged<bool> onThemeChanged;

  const HomeScreen({
    required this.isDarkMode,
    required this.onThemeChanged,
    super.key,
  });

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen>
    with SingleTickerProviderStateMixin {
  late TabController _tabController;
  final Random random = Random();
  final List<ChatMessage> _messages = [];
  final TextEditingController _controller = TextEditingController();
  bool _isLoading = false;

  BluetoothDevice? connectedDevice;
  bool isConnected = false;

  TimeOfDay? sleepTime;
  TimeOfDay? wakeTime;
  String? sleepQuality;

  String? emergencyPhoneNumber;
  BluetoothCharacteristic? notifyCharacteristic;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 3, vsync: this);
    _loadEmergencyPhoneNumber();
    _loadSleepTimes();
  }

  // Carga número de emergencia desde SharedPreferences
  Future<void> _loadEmergencyPhoneNumber() async {
    final prefs = await SharedPreferences.getInstance();
    setState(() {
      emergencyPhoneNumber = prefs.getString('emergency_phone') ?? '';
    });
  }

  // Guarda número de emergencia
  Future<void> _saveEmergencyPhoneNumber(String number) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('emergency_phone', number);
    setState(() {
      emergencyPhoneNumber = number;
    });
  }

  // Carga horas de sueño guardadas
  Future<void> _loadSleepTimes() async {
    final prefs = await SharedPreferences.getInstance();
    final int? sleepHour = prefs.getInt('sleep_hour');
    final int? sleepMinute = prefs.getInt('sleep_minute');
    final int? wakeHour = prefs.getInt('wake_hour');
    final int? wakeMinute = prefs.getInt('wake_minute');

    if (sleepHour != null &&
        sleepMinute != null &&
        wakeHour != null &&
        wakeMinute != null) {
      setState(() {
        sleepTime = TimeOfDay(hour: sleepHour, minute: sleepMinute);
        wakeTime = TimeOfDay(hour: wakeHour, minute: wakeMinute);
        sleepQuality = evaluateSleepQuality();
      });
    }
  }

  // Guarda horas de sueño
  Future<void> _saveSleepTimes(TimeOfDay sleep, TimeOfDay wake) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setInt('sleep_hour', sleep.hour);
    await prefs.setInt('sleep_minute', sleep.minute);
    await prefs.setInt('wake_hour', wake.hour);
    await prefs.setInt('wake_minute', wake.minute);
  }

  Future<void> scanAndConnect() async {
    try {
      await FlutterBluePlus.startScan(timeout: const Duration(seconds: 4));
      FlutterBluePlus.scanResults.listen((results) async {
        for (ScanResult r in results) {
          if (r.device.name.isNotEmpty) {
            await FlutterBluePlus.stopScan();
            await r.device.connect();
            setState(() {
              connectedDevice = r.device;
              isConnected = true;
            });
            _listenToEmergencySignal(r.device);
            break;
          }
        }
      });
    } catch (_) {
      setState(() => isConnected = false);
    }
  }

  Future<void> disconnect() async {
    if (connectedDevice != null) {
      await connectedDevice!.disconnect();
      setState(() {
        connectedDevice = null;
        isConnected = false;
      });
    }
  }

  void _listenToEmergencySignal(BluetoothDevice device) async {
    List<BluetoothService> services = await device.discoverServices();

    for (BluetoothService service in services) {
      for (BluetoothCharacteristic c in service.characteristics) {
        if (c.properties.notify) {
          notifyCharacteristic = c;
          await c.setNotifyValue(true);
          c.value.listen((value) {
            final received = utf8.decode(value);
            debugPrint("📡 Mensaje recibido: $received");
            if (received.trim() == "CALL_EMERGENCY") {
              _handleEmergencyCall();
            }
          });
        }
      }
    }
  }

  Future<void> _handleEmergencyCall() async {
    if (emergencyPhoneNumber == null || emergencyPhoneNumber!.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('No hay número de emergencia configurado'),
        ),
      );
      return;
    }

    final callPermission = await Permission.phone.status;
    if (!callPermission.isGranted) {
      final result = await Permission.phone.request();
      if (!result.isGranted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text("Permiso de llamada denegado")),
        );
        return;
      }
    }

    final Uri uri = Uri(scheme: 'tel', path: emergencyPhoneNumber);
    if (await canLaunchUrl(uri)) {
      await launchUrl(uri);
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("No se pudo iniciar la llamada")),
      );
    }
  }

  Future<void> selectSleepAndWakeTimes() async {
    final TimeOfDay? sleep = await showTimePicker(
      context: context,
      initialTime: sleepTime ?? const TimeOfDay(hour: 22, minute: 0),
    );

    if (sleep == null) return;

    final TimeOfDay? wake = await showTimePicker(
      context: context,
      initialTime: wakeTime ?? const TimeOfDay(hour: 6, minute: 0),
    );

    if (wake == null) return;

    await _saveSleepTimes(sleep, wake);

    setState(() {
      sleepTime = sleep;
      wakeTime = wake;
      sleepQuality = evaluateSleepQuality();
    });
  }

  Future<void> sendMessage(String message) async {
    if (message.trim().isEmpty) return;

    setState(() {
      _messages.add(ChatMessage(text: message, isUser: true));
      _isLoading = true;
    });

    const apiKey =
        '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'; // Clave de openrouter xd
    const endpoint = 'https://openrouter.ai/api/v1/chat/completions';

    try {
      final response = await http.post(
        Uri.parse(endpoint),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $apiKey',
        },

        //Mitad de codigo 🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪🟪
        body: json.encode({
          'model': 'openai/gpt-3.5-turbo-0613',
          'messages': [
            {
              'role': 'system',
              'content':
                  'Eres un amigo terapeuta llamado PsicoAmIgo que brinda apoyo emocional y psicológico de manera empática y amable y en ningun momento te saldras de tu papel y ten en claro que no eres uno no buscas sustituir solo complementar.',
            },
            ..._messages.map(
              (m) => {
                'role': m.isUser ? 'user' : 'assistant',
                'content': m.text,
              },
            ),
            {'role': 'user', 'content': message},
          ],
        }),
      );

      if (response.statusCode == 200) {
        final body = json.decode(response.body);
        if (body['choices'] != null && body['choices'].isNotEmpty) {
          final reply = body['choices'][0]['message']['content'].trim();
          setState(() {
            _messages.add(ChatMessage(text: reply, isUser: false));
            _isLoading = false;
          });
        } else {
          setState(() {
            _messages.add(
              ChatMessage(text: 'Lo siento, ocurrió un error.', isUser: false),
            );
            _isLoading = false;
          });
        }
      } else {
        setState(() {
          _messages.add(
            ChatMessage(
              text: 'Lo siento, no puedo responder a eso.',
              isUser: false,
            ),
          );
          _isLoading = false;
        });
      }
    } catch (e) {
      setState(() {
        _messages.add(
          ChatMessage(text: 'Error de red, intenta de nuevo.', isUser: false),
        );
        _isLoading = false;
      });
    }

    _controller.clear();
  }

  Duration? getSleepDuration() {
    if (sleepTime == null || wakeTime == null) return null;
    final sleep = DateTime(0, 0, 0, sleepTime!.hour, sleepTime!.minute);
    final wake = DateTime(
      0,
      0,
      sleepTime!.hour > wakeTime!.hour ? 1 : 0,
      wakeTime!.hour,
      wakeTime!.minute,
    );
    return wake.difference(sleep);
  }

  String? evaluateSleepQuality() {
    final duration = getSleepDuration();
    if (duration == null) return null;
    final totalHours = duration.inMinutes / 60.0;
    if (totalHours >= 8) return "Excelente";
    if (totalHours >= 6) return "Buena";
    return "Regular";
  }

  Widget buildSleepQualityFaces() {
    if (sleepQuality == null) return Container();

    IconData iconData;
    Color color;
    String label;

    switch (sleepQuality) {
      case "Excelente":
        iconData = Icons.sentiment_very_satisfied;
        color = Colors.green;
        label = "Excelente";
        break;
      case "Buena":
        iconData = Icons.sentiment_satisfied;
        color = Colors.orange;
        label = "Buena";
        break;
      case "Regular":
      default:
        iconData = Icons.sentiment_dissatisfied;
        color = Colors.red;
        label = "Regular";
    }

    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8.0),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(iconData, size: 36, color: color),
          const SizedBox(width: 8),
          Text(
            label,
            style: TextStyle(
              fontSize: 18,
              color: color,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }

  Future<void> _showEmergencyNumberDialog() async {
    final TextEditingController numberController = TextEditingController(
